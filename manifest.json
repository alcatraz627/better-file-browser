{
  "manifest_version": 3,
  "name": "Better File Browser",
  "version": "2.12.0",
  "description": "Transforms Chrome's plain directory listings into a rich, modern file explorer with file previews and local-model AI",
  "permissions": ["storage", "nativeMessaging", "clipboardWrite", "tabs", "alarms", "idle"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": { "16": "icon16.png", "48": "icon48.png", "128": "icon128.png" },
    "default_title": "Better File Browser"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    { "resources": ["vendor-mermaid.js", "search-worker.js", "assets/favicon.svg", "assets/app-icons/*.svg"], "matches": ["file://*/*"] }
  ],
  "content_scripts": [
    {
      "matches": ["file://*/*"],
      "js": ["loader.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["file://*/*"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.booking.com/*",
        "https://*.airbnb.com/*", "https://*.airbnb.co.in/*", "https://*.airbnb.co.uk/*",
        "https://*.airbnb.ca/*", "https://*.airbnb.com.au/*", "https://*.airbnb.co.nz/*",
        "https://*.airbnb.ie/*", "https://*.airbnb.de/*", "https://*.airbnb.fr/*",
        "https://*.airbnb.es/*", "https://*.airbnb.it/*", "https://*.airbnb.nl/*",
        "https://*.airbnb.be/*", "https://*.airbnb.ch/*", "https://*.airbnb.at/*",
        "https://*.airbnb.pt/*", "https://*.airbnb.se/*", "https://*.airbnb.dk/*",
        "https://*.airbnb.no/*", "https://*.airbnb.fi/*", "https://*.airbnb.pl/*",
        "https://*.airbnb.cz/*", "https://*.airbnb.gr/*", "https://*.airbnb.jp/*",
        "https://*.airbnb.co.kr/*", "https://*.airbnb.com.sg/*", "https://*.airbnb.com.hk/*",
        "https://*.airbnb.com.tw/*", "https://*.airbnb.com.br/*", "https://*.airbnb.mx/*",
        "https://*.airbnb.ae/*", "https://*.airbnb.co.za/*"
      ],
      "js": ["site-plugins.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://*.booking.com/*",
        "https://*.airbnb.com/*", "https://*.airbnb.co.in/*", "https://*.airbnb.co.uk/*",
        "https://*.airbnb.ca/*", "https://*.airbnb.com.au/*", "https://*.airbnb.co.nz/*",
        "https://*.airbnb.ie/*", "https://*.airbnb.de/*", "https://*.airbnb.fr/*",
        "https://*.airbnb.es/*", "https://*.airbnb.it/*", "https://*.airbnb.nl/*",
        "https://*.airbnb.be/*", "https://*.airbnb.ch/*", "https://*.airbnb.at/*",
        "https://*.airbnb.pt/*", "https://*.airbnb.se/*", "https://*.airbnb.dk/*",
        "https://*.airbnb.no/*", "https://*.airbnb.fi/*", "https://*.airbnb.pl/*",
        "https://*.airbnb.cz/*", "https://*.airbnb.gr/*", "https://*.airbnb.jp/*",
        "https://*.airbnb.co.kr/*", "https://*.airbnb.com.sg/*", "https://*.airbnb.com.hk/*",
        "https://*.airbnb.com.tw/*", "https://*.airbnb.com.br/*", "https://*.airbnb.mx/*",
        "https://*.airbnb.ae/*", "https://*.airbnb.co.za/*"
      ],
      "js": ["site-bridge.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
